#!/usr/bin/env bash
# livewall: Search YouTube or play local videos as live wallpaper
# Usage: livewall [query|history|local [directory]|/path/to/video.mp4]

# Resolve Lib Dir & Source Utils
LIB_DIR=""
if [ -f "$(dirname "$0")/../lib/utils.sh" ]; then
    LIB_DIR="$(dirname "$0")/../lib"
elif [ -f "$(dirname "$0")/../lib/livewall/utils.sh" ]; then
    LIB_DIR="$(dirname "$0")/../lib/livewall"
fi

if [ -n "$LIB_DIR" ] && [ -f "$LIB_DIR/utils.sh" ]; then
    # shellcheck source=../lib/utils.sh
    source "$LIB_DIR/utils.sh"
else
    echo "Error: utils.sh not found in $LIB_DIR"
    exit 1
fi

# Help
if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    echo "livewall - Live Wallpaper for YouTube & Local Videos"
    echo ""
    echo "Usage: livewall [command|query|file]"
    echo ""
    echo "Commands:"
    echo "  <query>               Search YouTube and play video"
    echo "  /path/to/file.mp4     Play local video file"
    echo "  local [directory]     Browse local videos (default: ~/Videos)"
    echo "  history               Replay watch history"
    echo "  stop                  Stop playback"
    echo "  logs [options]        View logs"
    echo "  --help, -h            Show this help message"
    echo ""
    echo "Log Options:"
    echo "  -f, --follow          Follow log output (tail -f)"
    echo "  control               View control log (default)"
    echo "  search                View search log"
    echo "  preview               View preview log"
    echo ""
    echo "Examples:"
    echo "  livewall \"lofi hip hop\""
    echo "  livewall https://youtu.be/dQw4w9WgXcQ"
    echo "  livewall ~/Videos/video.mp4"
    echo "  livewall logs -f control"
    exit 0
fi

# Resolve Preview Script
PREVIEW_SCRIPT="${PREVIEW_SCRIPT_PATH:-$LIB_DIR/preview.sh}"

HISTORY_FILE="$HOME/.local/share/livewall/history"
mkdir -p "$(dirname "$HISTORY_FILE")"

# Local logging wrapper to specific file
SEARCH_LOG="$RUNTIME_DIR/search.log"
log_msg() {
    log "$1" "$SEARCH_LOG"
}

# Local File Browser
browse_local_videos() {
    local search_dir="${1:-$HOME/Videos}"
    
    # Expand ~ to home directory
    search_dir="${search_dir/#\~/$HOME}"
    
    if [ ! -d "$search_dir" ]; then
        echo "Error: Directory '$search_dir' not found."
        exit 1
    fi
    
    echo "Searching for videos in: $search_dir"
    
    # Find all video files and format for fzf
    # Format: filename<TAB>path<TAB>size
    SELECTED=$(find "$search_dir" -type f -regextype posix-extended -iregex ".*\.($VIDEO_EXTS)$" 2>/dev/null | \
        while IFS= read -r file; do
            filename=$(basename "$file")
            size=$(du -h "$file" 2>/dev/null | cut -f1)
            echo -e "$filename\t$file\t$size"
        done | \
        fzf \
            --delimiter=$'\t' \
            --with-nth=1,3 \
            --preview 'echo -e "\033[1;36m📁 File:\033[0m\n   {1}\n\n\033[1;35m📂 Path:\033[0m\n   {2}\n\n\033[1;32m💾 Size:\033[0m\n   {3}"' \
            --preview-window=right:50%:wrap \
            --header="Select Local Video" \
            --prompt="Local> ")
    
    if [ -n "$SELECTED" ]; then
        # Extract file path (2nd field)
        FILE_PATH=$(echo "$SELECTED" | awk -F'\t' '{print $2}')
        
        if [ -f "$FILE_PATH" ]; then
            # Add to history with [LOCAL] marker
            TIMESTAMP=$(date '+%Y-%m-%d %H:%M')
            FILENAME=$(basename "$FILE_PATH")
            echo -e "${TIMESTAMP}\t[LOCAL] ${FILENAME}\t\t\t${FILE_PATH}\tlocal" >> "$HISTORY_FILE"
            
            # Play the file
            livewall-control play "$FILE_PATH"
        fi
    fi
    exit 0
}

# History Mode
if [ "$1" == "history" ]; then
    if [ ! -s "$HISTORY_FILE" ]; then
        echo "No history found."
        exit 0
    fi

    # Display history in reverse order (newest first)
    # Using tac to reverse, and fzf for selection
    # Format in history: Timestamp<TAB>Title<TAB>Channel<TAB>Duration<TAB>URL<TAB>ID
    SELECTED=$(tac "$HISTORY_FILE" | fzf \
      --delimiter=$'\t' \
      --with-nth=2 \
      --preview-window=up:60% \
      --header="Select to Replay" \
      --prompt="History> ")

    if [ -n "$SELECTED" ]; then
        # Extract URL (5th field in history file)
        # History format: Date \t Title \t Channel \t Duration \t URL \t ID
        URL=$(echo "$SELECTED" | awk -F'\t' '{print $(NF-1)}')

        # Log this replay as a new entry? Yes, brings it to top.
        # But we need the original full line data to re-log it properly?
        # Simpler: just play it. If we want to bring to top, we'd need to parse more fields.
        # Let's just play it for now.

        livewall-control play "$URL"
    fi
    exit 0
fi

# Stop Mode
if [ "$1" == "stop" ]; then
    livewall-control stop
    exit 0
fi

# Logs Mode
if [ "$1" == "logs" ]; then
    shift
    FOLLOW=false
    LOG_FILE="control"

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -f|--follow) FOLLOW=true; shift ;;
            control|search|preview) LOG_FILE="$1"; shift ;;
            *) echo "Error: Unknown option: $1"; echo "Use 'livewall logs --help' for usage."; exit 1 ;;
        esac
    done

    LOG_PATH="$RUNTIME_DIR/${LOG_FILE}.log"
    if [ ! -f "$LOG_PATH" ]; then
        echo "Error: No logs found. Run livewall first."
        exit 1
    fi

    if [ "$FOLLOW" = true ]; then
        tail -f "$LOG_PATH"
    else
        tail -50 "$LOG_PATH"
    fi
    exit 0
fi

# Local Browser Mode
if [ "$1" == "local" ]; then
    shift
    browse_local_videos "$@"
fi

# Check if argument is a local file path
if [ -n "$1" ]; then
    FILE_PATH=$(is_local_video_file "$*")
    if [ $? -eq 0 ]; then
        log_msg "Playing local file: $FILE_PATH"
        
        # Add to history
        TIMESTAMP=$(date '+%Y-%m-%d %H:%M')
        FILENAME=$(basename "$FILE_PATH")
        echo -e "${TIMESTAMP}\t[LOCAL] ${FILENAME}\t\t\t${FILE_PATH}\tlocal" >> "$HISTORY_FILE"
        
        # Play the file
        livewall-control play "$FILE_PATH"
        exit 0
    fi
fi

# Ensure we are in the flake env or have dependencies
if ! command -v yt-dlp &> /dev/null; then
    echo "Error: yt-dlp not found. Please run inside 'nix develop'."
    exit 1
fi

# Ask for query if not provided as argument
if [ -n "$1" ]; then
    QUERY="$*"
else
    echo -ne "\033[1;34mSearch YouTube: \033[0m"
    read QUERY
fi

if [ -z "$QUERY" ]; then
  exit 0
fi

# Detect YouTube URLs and play directly
if [[ "$QUERY" =~ ^https?://((www\.|m\.)?youtube\.com/watch\?v=|youtu\.be/) ]]; then
    log_msg "Detected YouTube URL, playing directly: $QUERY"
    livewall-control play "$QUERY"
    exit 0
fi

# Cookie Authentication: DISABLED
# YouTube's JS challenge solver is broken in current yt-dlp versions (2026.02.x)
# For most use cases (streaming wallpapers), authentication is not needed
# If you need authenticated access (e.g., age-restricted content), export
# cookies manually from Firefox and use: yt-dlp --cookies cookies.txt
declare -a COOKIE_ARGS=()

log_msg "Searching for: $QUERY"

# Fetch and Stream to FZF (Search)
# Note: Using empty COOKIE_ARGS array - no authentication
echo "Searching..."

SELECTED=$(yt-dlp "${COOKIE_ARGS[@]}" \
  --print $'%(title)s\t%(channel)s\t%(duration_string)s\t%(webpage_url)s\t%(id)s' \
  --flat-playlist --no-warnings \
  "ytsearch20:$QUERY" \
  | awk -F'\t' '!seen[$NF]++ {print; fflush()}' \
  | fzf \
    --delimiter=$'\t' \
    --with-nth=1 \
    --no-mouse \
    --preview "$PREVIEW_SCRIPT {}" \
    --preview-window=right:50%:wrap)

if [ -n "$SELECTED" ]; then
  log_msg "Selected raw: $SELECTED"

  # Extract URL (4th field)
  # Use awk for more robust tab separation
  # Fix: Use $(NF-1) because tabs in titles shift the columns.
  # The format is: Title... Channel Duration URL ID
  # So URL is always second to last, ID is last.
  URL=$(echo "$SELECTED" | awk -F'\t' '{print $(NF-1)}')

  # Trim whitespace just in case
  URL=$(echo "$URL" | xargs)

  log_msg "Extracted URL: $URL"

  if [[ "$URL" != http* ]]; then
       log_msg "ERROR: URL does not start with http"
       log_msg "Awk Debug: Number of fields: $(echo "$SELECTED" | awk -F'\t' '{print NF}')"
       log_msg "Awk Debug: Last field (ID): $(echo "$SELECTED" | awk -F'\t' '{print $NF}')"
       log_msg "Awk Debug: 2nd to last (URL): $(echo "$SELECTED" | awk -F'\t' '{print $(NF-1)}')"

       notify-send "Error" "Failed to extract valid URL. Check CLI output."
       exit 1
  fi

  # Log to history
  # Format: Date<TAB>OriginalLine
  TIMESTAMP=$(date '+%Y-%m-%d %H:%M')
  echo -e "${TIMESTAMP}\t${SELECTED}" >> "$HISTORY_FILE"

  # Call control script to play
  # We assume livewall-control is in PATH (added by flake shellHook)
  livewall-control play "$URL"
fi
