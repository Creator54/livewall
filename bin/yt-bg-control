#!/usr/bin/env bash
# yt-bg-control: Control YouTube wallpaper playback
# Commands: play <url>, toggle-pip, toggle-pause, toggle-mute, cycle-quality, seek-forward, seek-backward, download, open

SOCKET="/tmp/live-wallpaper-socket"
LOG_FILE="/tmp/yt-bg-control.log"
QUALITY_FILE="/tmp/yt-bg-quality"

# Quality Definitions
# default: 1080p
# We exclude AV1 if possible for better hardware decoding compatibility on some systems
get_quality_opts() {
    case "$1" in
        "best") echo "--ytdl-format=bestvideo+bestaudio/best" ;;
        "1080p") echo "--ytdl-format=bestvideo[height<=1080]+bestaudio/best[height<=1080]" ;;
        "720p") echo "--ytdl-format=bestvideo[height<=720]+bestaudio/best[height<=720]" ;;
        "480p") echo "--ytdl-format=bestvideo[height<=480]+bestaudio/best[height<=480]" ;;
        *) echo "--ytdl-format=bestvideo[height<=1080]+bestaudio/best[height<=1080]" ;; # Default 1080p
    esac
}

# Get current quality preference, default to 1080p if not set
CURRENT_QUALITY="1080p"
if [ -f "$QUALITY_FILE" ]; then
    CURRENT_QUALITY=$(cat "$QUALITY_FILE")
fi
MPV_OPTS=$(get_quality_opts "$CURRENT_QUALITY")

# Prepare Script Options
QUALITY_SCRIPT_OPT=""
if [ -n "$QUALITY_SCRIPT_PATH" ] && [ -f "$QUALITY_SCRIPT_PATH" ]; then
    QUALITY_SCRIPT_OPT="--script=$QUALITY_SCRIPT_PATH"
fi

log() {
  echo "[LOG] $1" >&2
  echo "[$(date '+%H:%M:%S')] $1" >> "$LOG_FILE"
}

# Ensure socket dir exists
mkdir -p "$(dirname "$SOCKET")"

# Helper to get property from mpv via json IPC
get_prop() {
  echo "{ \"command\": [\"get_property\", \"$1\"] }" | socat - "$SOCKET" 2>/dev/null | jq -r .data
}

case "$1" in
  "play")
    URL="$2"
    if [ -z "$URL" ]; then exit 1; fi

    log "Playing URL: $URL"

    # Check if either mpvpaper or mpv (pip) is running on the socket
    if [ -S "$SOCKET" ] && (pgrep -f "mpvpaper.*$SOCKET" || pgrep -f "mpv.*$SOCKET"); then
       log "Switching existing player"
       echo "loadfile \"$URL\"" | socat - "$SOCKET"
       notify-send "YouTube Video" "Loading..."
    else
       # Start mpvpaper (default mode)
       log "Starting new mpvpaper instance"
       notify-send "YouTube Video" "Loading..."

       # Kill old processes
       pkill swaybg || true
       pkill mpvpaper || true
       pkill mpv || true

       # Remove stale socket
       rm -f "$SOCKET"

       # Small delay to ensure processes are dead
       sleep 0.3

       # Start mpvpaper
       # CRITICAL: Do NOT use --script=mpris.so with mpvpaper, it crashes.
       mpvpaper -o "--loop --input-ipc-server=$SOCKET --panscan=1.0 $MPV_OPTS $QUALITY_SCRIPT_OPT" '*' "$URL" >> "$LOG_FILE" 2>&1 &

       # Check if it started
       sleep 2
       if ! pgrep -f "mpvpaper" > /dev/null; then
          log "mpvpaper failed to start"
          notify-send "Error" "Failed to start video"
       fi
    fi
    ;;

  "toggle-pip")
    if [ ! -S "$SOCKET" ]; then exit 1; fi

    # Get current state
    URL=$(get_prop "path")
    POS=$(get_prop "time-pos")
    PAUSE=$(get_prop "pause")

    if [ "$URL" == "null" ] || [ -z "$URL" ]; then exit 1; fi
    log "Toggling PiP. URL: $URL, Pos: $POS"

    # Determine current mode by checking process
    # If mpvpaper is running, we switch to mpv (floating)
    if pgrep -f "mpvpaper.*$SOCKET"; then
       # Switch to PiP
       pkill mpvpaper

       # Wait a bit
       sleep 0.2

       # Start mpv in floating mode
       # We resume position
       START_OPT=""
       if [ "$POS" != "null" ]; then START_OPT="--start=$POS"; fi

       # Start mpv WITH MPRIS support if available
       SCRIPT_OPT=""
       if [ -n "$MPRIS_SCRIPT_PATH" ] && [ -f "$MPRIS_SCRIPT_PATH" ]; then
           SCRIPT_OPT="--script=$MPRIS_SCRIPT_PATH"
       fi

       mpv --input-ipc-server=$SOCKET --loop --title="Live Wallpaper PiP" --force-window $START_OPT $SCRIPT_OPT $QUALITY_SCRIPT_OPT $MPV_OPTS "$URL" >> "$LOG_FILE" 2>&1 &

       # Restore static wallpaper behind it
       # Check if wallpaper file exists, otherwise skip or use a default color if desired (omitted for now)
       if [ -f "$HOME/.current_wallpaper" ]; then
           (sleep 1; swaybg -m fill -i "$HOME/.current_wallpaper" &) &
       fi

    elif pgrep -f "mpv.*$SOCKET"; then
       # Switch back to Wallpaper
       pkill mpv
       pkill swaybg # kill static bg

       sleep 0.2

       START_OPT=""
       if [ "$POS" != "null" ]; then START_OPT="--start=$POS"; fi

       mpvpaper -o "--loop --input-ipc-server=$SOCKET --panscan=1.0 $START_OPT $MPV_OPTS $QUALITY_SCRIPT_OPT" '*' "$URL" >> "$LOG_FILE" 2>&1 &
    fi
    ;;

  "toggle-pause")
    echo 'cycle pause' | socat - "$SOCKET"
    ;;
  "toggle-mute")
    echo 'cycle mute' | socat - "$SOCKET"
    ;;
  "seek-forward")
    echo 'seek 10' | socat - "$SOCKET"
    ;;
  "seek-backward")
    echo 'seek -10' | socat - "$SOCKET"
    ;;
  "download")
    URL=$(get_prop "path")
    TITLE=$(get_prop "media-title")
    TERMINAL="${TERMINAL:-kitty}"

    if [ -n "$URL" ] && [ "$URL" != "null" ]; then
       notify-send "Wallpaper" "Downloading: $TITLE"

       if command -v "$TERMINAL" > /dev/null; then
            $TERMINAL --class floating-term --hold -e sh -c "yt-dlp --external-downloader axel --external-downloader-args '-n 10' -o '$HOME/Downloads/%(title)s.%(ext)s' '$URL'; echo \"\"; echo 'Download finished. Press Enter to close.'; read" &
       else
            notify-send "Error" "Terminal '$TERMINAL' not found for download."
       fi
    else
       notify-send "Error" "No video playing"
    fi
    ;;
  "open")
    URL=$(get_prop "path")
    if [ -n "$URL" ] && [ "$URL" != "null" ]; then
       notify-send "Wallpaper" "Opening in browser..."
       xdg-open "$URL"
    else
       notify-send "Error" "No video playing"
    fi
    ;;
  "cycle-quality")
    # Cycle order: 1080p -> 720p -> 480p -> best -> 1080p
    NEXT_QUALITY="1080p"
    case "$CURRENT_QUALITY" in
        "1080p") NEXT_QUALITY="720p" ;;
        "720p") NEXT_QUALITY="480p" ;;
        "480p") NEXT_QUALITY="best" ;;
        "best") NEXT_QUALITY="1080p" ;;
    esac

    # Save preference
    echo "$NEXT_QUALITY" > "$QUALITY_FILE"
    notify-send "Wallpaper" "Switching quality to $NEXT_QUALITY..."
    log "Switching quality from $CURRENT_QUALITY to $NEXT_QUALITY"

    # Reload if playing
    if [ -S "$SOCKET" ]; then
        URL=$(get_prop "path")
        POS=$(get_prop "time-pos")

        if [ "$URL" != "null" ] && [ -n "$URL" ]; then
            # We can't change ytdl-format on the fly easily without reloading the file.
            # mpv supports 'set ytdl-format ...' but it only takes effect on next load.
            NEW_OPTS=$(get_quality_opts "$NEXT_QUALITY")
            YTDL_FMT=$(echo "$NEW_OPTS" | sed 's/--ytdl-format=//')

            # Send command to update property and reload
            echo "{ \"command\": [\"set_property\", \"ytdl-format\", \"$YTDL_FMT\"] }" | socat - "$SOCKET" >/dev/null

            # Seek to current position to force reload/re-buffer (or just reload file)
            # 'loadfile url replace start=POS' is cleanest
            if [ "$POS" == "null" ]; then POS=0; fi
            echo "loadfile \"$URL\" replace start=$POS" | socat - "$SOCKET"
        fi
    fi
    ;;
esac
