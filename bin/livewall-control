#!/usr/bin/env bash
# livewall-control: Control live wallpaper playback (YouTube or local videos)
# Commands: play <url|path>, toggle-pip, toggle-pause, toggle-mute, cycle-quality, seek-forward, seek-backward, download, open

# Resolve Lib Dir & Source Utils
LIB_DIR=""
if [ -f "$(dirname "$0")/../lib/utils.sh" ]; then
    LIB_DIR="$(dirname "$0")/../lib"
elif [ -f "$(dirname "$0")/../lib/livewall/utils.sh" ]; then
    LIB_DIR="$(dirname "$0")/../lib/livewall"
fi

if [ -n "$LIB_DIR" ] && [ -f "$LIB_DIR/utils.sh" ]; then
    # shellcheck source=../lib/utils.sh
    source "$LIB_DIR/utils.sh"
else
    echo "Error: utils.sh not found in $LIB_DIR"
    exit 1
fi

# Local logging wrapper with severity levels
CONTROL_LOG="$RUNTIME_DIR/control.log"
log_msg() {
    log "$1" "$CONTROL_LOG"
}

log_info() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [INFO] $1" >> "$CONTROL_LOG"
}

log_error() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [ERROR] $1" >> "$CONTROL_LOG"
}

log_debug() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [DEBUG] $1" >> "$CONTROL_LOG"
}

# Log environment state for debugging
log_env() {
    log_debug "ENV: WAYLAND_DISPLAY=$WAYLAND_DISPLAY XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR"
    log_debug "ENV: PATH contains livewall: $(echo $PATH | grep -o '/[^:]*livewall[^:]*' | head -1)"
    log_debug "STATE: mpvpaper=$(pgrep mpvpaper || echo 'none') swaybg=$(pgrep swaybg || echo 'none')"
}

# Check if path is a local file (replaced by shared utils)
# is_local_video_file() removed

# Zen Browser (Firefox-based) profile detection for cookies
ZEN_PROFILE=$(detect_zen_profile)
COOKIE_OPTS=""
if [ -n "$ZEN_PROFILE" ]; then
    # Create a symlink to avoid space issues in MPV/yt-dlp options (e.g. "Default Profile")
    rm -f "$ZEN_PROFILE_LINK"
    ln -s "$ZEN_PROFILE" "$ZEN_PROFILE_LINK"

    # Write complex options to a config file to avoid CLI parsing issues with spaces/semicolons
    echo "ytdl-raw-options-append=cookies-from-browser=firefox:$ZEN_PROFILE_LINK" > "$COOKIE_CONFIG"
    echo "ytdl-raw-options-append=user-agent=Mozilla/5.0 (X11; Linux x86_64; rv:133.0) Gecko/20100101 Firefox/133.0" >> "$COOKIE_CONFIG"

    COOKIE_OPTS="--include=$COOKIE_CONFIG"
fi

# Performance Flags:
# --cache=yes --demuxer-max-bytes=512M: Aggressive buffering for high-speed connections
# --demuxer-max-back-bytes=100M: Allow seeking back without re-downloading
PERF_FLAGS="--cache=yes --demuxer-max-bytes=512M --demuxer-max-back-bytes=100M"

# Quality Definitions
# default: 1080p
# We exclude AV1 ([vcodec!^=av01]) because we are forcing software decoding (--hwdec=no).
# AV1 software decoding is very CPU intensive and causes stuttering/freezing.
get_fmt_string() {
    case "$1" in
        "best") echo "bestvideo[vcodec!^=av01]+bestaudio/best" ;;
        "1080p") echo "bestvideo[height<=1080][vcodec!^=av01]+bestaudio/best[height<=1080]" ;;
        "720p") echo "bestvideo[height<=720][vcodec!^=av01]+bestaudio/best[height<=720]" ;;
        "480p") echo "bestvideo[height<=480][vcodec!^=av01]+bestaudio/best[height<=480]" ;;
        *) echo "bestvideo[height<=1080][vcodec!^=av01]+bestaudio/best[height<=1080]" ;;
    esac
}

# Get current quality preference, default to 1080p if not set
CURRENT_QUALITY="1080p"
if [ -f "$QUALITY_FILE" ]; then
    CURRENT_QUALITY=$(cat "$QUALITY_FILE")
fi

# Prepare Script Options
QUALITY_SCRIPT_OPT=""
# Resolve Quality Script Path
QUALITY_SCRIPT="${QUALITY_SCRIPT_PATH:-$LIB_DIR/quality-cycle.lua}"

if [ -n "$QUALITY_SCRIPT" ] && [ -f "$QUALITY_SCRIPT" ]; then
    QUALITY_SCRIPT_OPT="--script=$QUALITY_SCRIPT"
fi

# Helper to get property from mpv via json IPC
get_prop() {
  echo "{ \"command\": [\"get_property\", \"$1\"] }" | socat - "$IPC_SOCKET" 2>/dev/null | jq -r .data
}


case "$1" in
  "--help"|"-h")
    echo "livewall-control - Playback controller for livewall"
    echo "Usage: livewall-control <command> [args]"
    echo ""
    echo "Commands:"
    echo "  play <url|path>       Play video from URL or local path"
    echo "  toggle-pip            Toggle between Wallpaper and PiP mode"
    echo "  toggle-pause          Pause/Resume playback"
    echo "  toggle-mute           Mute/Unmute audio"
    echo "  cycle-quality         Cycle video quality (1080p -> 720p -> ...)"
    echo "  seek-forward          Seek forward 10s"
    echo "  seek-backward         Seek backward 10s"
    echo "  download              Download current video (YouTube only)"
    echo "  open                  Open video in browser or file manager"
    echo "  cycle-fit             Cycle aspect ratio fit modes"
    echo "  cycle-aspect          Cycle proper aspect ratio overrides"
    echo "  --help, -h            Show this help message"
    exit 0
    ;;

  "play")
    URL="$2"
    if [ -z "$URL" ]; then exit 1; fi

    # Prevent concurrent executions with lock file
    LOCK_FILE="$RUNTIME_DIR/play.lock"
    exec 9>"$LOCK_FILE"
    if ! flock -n 9; then
        log_info "Another play command is running, waiting..."
        flock 9  # Wait for lock
    fi
    trap 'rm -f "$LOCK_FILE"' EXIT

    log_info "=== PLAY COMMAND INITIATED ==="
    log_env
    log_info "URL: $URL"

    # Check if it's a local file
    LOCAL_FILE=$(is_local_video_file "$URL")
    IS_LOCAL=$?
    
    if [ $IS_LOCAL -eq 0 ]; then
        log_info "Detected local file: $LOCAL_FILE"
        URL="$LOCAL_FILE"
        MPV_OPTS="--hwdec=no $PERF_FLAGS"
        log_debug "Using local file options: $MPV_OPTS"
    else
        FMT=$(get_fmt_string "$CURRENT_QUALITY")
        MPV_OPTS="--ytdl-format=$FMT --hwdec=no $PERF_FLAGS $COOKIE_OPTS"
        log_info "Using YouTube with quality: $CURRENT_QUALITY"
        log_debug "MPV options: $MPV_OPTS"
    fi

    # Check if socket exists AND is functional (not stale)
    SOCKET_ALIVE=false
    if [ -S "$IPC_SOCKET" ]; then
        # Verify socket is actually responding (not stale)
        if echo '{ "command": ["get_property", "path"] }' | timeout 1 socat - "$IPC_SOCKET" > /dev/null 2>&1; then
            SOCKET_ALIVE=true
            log_debug "Socket is alive and responding"
        else
            log_debug "Socket exists but not responding (stale), will restart"
            rm -f "$IPC_SOCKET"
        fi
    fi
    
    if [ "$SOCKET_ALIVE" = true ] && (pgrep -f "mpvpaper" > /dev/null || pgrep -f "mpv" > /dev/null); then
       log_info "Existing player found, switching video via IPC"
       log_debug "IPC socket: $IPC_SOCKET"
       echo "loadfile \"$URL\"" | socat - "$IPC_SOCKET"
       notify-send "Live Wallpaper" "Loading..."
    else
       # Start mpvpaper (default mode)
       log_info "=== STARTING NEW MPVPAPER INSTANCE ==="
       log_debug "Runtime dir: $RUNTIME_DIR"
       log_debug "IPC socket: $IPC_SOCKET"
       notify-send "Live Wallpaper" "Loading..."

       # Kill old processes
       log_debug "Cleaning up old processes..."
       pkill swaybg || true
       pkill mpvpaper || true
       pkill mpv || true

       # Wait for players (and swaybg) to die to free up socket/resources/layer
       count=0
       while (pgrep -f "mpvpaper" > /dev/null || pgrep -f "mpv" > /dev/null || pgrep -x "swaybg" > /dev/null) && [ $count -lt 20 ]; do
           sleep 0.1
           count=$((count+1))
       done

       # Force kill if still running
       if pgrep -f "mpvpaper" > /dev/null; then pkill -9 mpvpaper; fi
       if pgrep -f "mpv" > /dev/null; then pkill -9 mpv; fi
       if pgrep -x "swaybg" > /dev/null; then pkill -9 swaybg; fi

       # Remove stale socket
       rm -f "$IPC_SOCKET"

       # Start mpvpaper
       log_info "Launching mpvpaper with verbose output"
       log_debug "Command: mpvpaper -v -o '--loop --input-ipc-server=$IPC_SOCKET $MPV_OPTS $QUALITY_SCRIPT_OPT' '*' '$URL'"
       # Use setsid to fully detach from terminal (prevents SIGHUP when kitty closes)
       setsid mpvpaper -v -o "--loop --input-ipc-server=$IPC_SOCKET $MPV_OPTS $QUALITY_SCRIPT_OPT" '*' "$URL" >> "$CONTROL_LOG" 2>&1 &
       MPVPAPER_PID=$!
       log_debug "mpvpaper PID: $MPVPAPER_PID (detached with setsid)"

       # Check if it started
       sleep 2
       if ! pgrep -f "mpvpaper" > /dev/null; then
          log_error "mpvpaper failed to start (no process found after 2s)"
          log_error "Check previous lines for mpvpaper error output"
          notify-send "Error" "Failed to start video"
       fi
    fi
    ;;

  "toggle-pip")
    if [ ! -S "$IPC_SOCKET" ]; then exit 1; fi

    # Get current state
    URL=$(get_prop "path")
    POS=$(get_prop "time-pos")
    PAUSE=$(get_prop "pause")
    # Optimize toggle: Try to get the direct stream URL to avoid re-resolving with yt-dlp
    STREAM_URL=$(get_prop "stream-path")

    if [ "$URL" == "null" ] || [ -z "$URL" ]; then exit 1; fi
    log_msg "Toggling PiP. URL: $URL, Pos: $POS"
    log_msg "Stream URL candidate: $STREAM_URL"

    # Check if it's a local file
    LOCAL_FILE=$(is_local_video_file "$URL")
    IS_LOCAL=$?
    
    # Use stream URL if available (faster), otherwise fallback to original URL
    PLAY_URL="$URL"
    if [ $IS_LOCAL -eq 0 ]; then
        # Local file - use original path
        PLAY_URL="$LOCAL_FILE"
        MPV_OPTS="--hwdec=no $PERF_FLAGS"
        log_msg "Local file detected for PiP toggle"
    elif [ "$STREAM_URL" != "null" ] && [ -n "$STREAM_URL" ]; then
        PLAY_URL="$STREAM_URL"
        FMT=$(get_fmt_string "$CURRENT_QUALITY")
        MPV_OPTS="--ytdl-format=$FMT --hwdec=no $PERF_FLAGS $COOKIE_OPTS"
        log_msg "Using direct stream URL (Fast switch)"
    else
        FMT=$(get_fmt_string "$CURRENT_QUALITY")
        MPV_OPTS="--ytdl-format=$FMT --hwdec=no $PERF_FLAGS $COOKIE_OPTS"
        log_msg "Stream URL missing. Falling back to resolving URL (Slow switch)"
    fi

    # Determine current mode by checking process
    # If mpvpaper is running, we switch to mpv (floating)
    if pgrep -f "mpvpaper.*$IPC_SOCKET"; then
       # Switch to PiP
       pkill mpvpaper

       # Wait for process to die
       count=0
       while pgrep -f "mpvpaper.*$IPC_SOCKET" > /dev/null && [ $count -lt 20 ]; do
           sleep 0.1
           count=$((count+1))
       done

       # Force kill if stuck
       if pgrep -f "mpvpaper.*$IPC_SOCKET" > /dev/null; then
           pkill -9 mpvpaper
       fi

       # Clean up socket
       rm -f "$IPC_SOCKET"

       # Start mpv in floating mode
       # We resume position
       START_OPT=""
       if [ "$POS" != "null" ]; then START_OPT="--start=$POS"; fi

       # Start mpv WITH MPRIS support if available
       SCRIPT_OPT=""
       if [ -n "$MPRIS_SCRIPT_PATH" ] && [ -f "$MPRIS_SCRIPT_PATH" ]; then
           SCRIPT_OPT="--script=$MPRIS_SCRIPT_PATH"
       fi

       # Use PLAY_URL (direct stream) but keep original URL metadata for history/context if possible
       # We just play the stream directly for speed.
       mpv --input-ipc-server=$IPC_SOCKET --loop --title="Live Wallpaper PiP" --force-window $START_OPT $SCRIPT_OPT $QUALITY_SCRIPT_OPT $MPV_OPTS "$PLAY_URL" >> "$CONTROL_LOG" 2>&1 &

       # Restore static wallpaper behind it
       # Check if wallpaper file exists, otherwise skip or use a default color if desired (omitted for now)
       if [ -f "$HOME/.current_wallpaper" ]; then
           (sleep 1; swaybg -m fill -i "$HOME/.current_wallpaper" &) &
       fi

    elif pgrep -f "mpv.*$IPC_SOCKET"; then
       # Switch back to Wallpaper
       pkill mpv
       pkill swaybg # kill static bg

       # Wait for process to die
       count=0
       while pgrep -f "mpv.*$IPC_SOCKET" > /dev/null && [ $count -lt 20 ]; do
           sleep 0.1
           count=$((count+1))
       done

       # Force kill if stuck
       if pgrep -f "mpv.*$IPC_SOCKET" > /dev/null; then
           pkill -9 mpv
       fi

       # Clean up socket
       rm -f "$IPC_SOCKET"

       START_OPT=""
       if [ "$POS" != "null" ]; then START_OPT="--start=$POS"; fi

       setsid mpvpaper -v -o "--loop --input-ipc-server=$IPC_SOCKET $START_OPT $MPV_OPTS $QUALITY_SCRIPT_OPT" '*' "$PLAY_URL" >> "$CONTROL_LOG" 2>&1 &
    fi
    ;;

  "toggle-pause")
    echo 'cycle pause' | socat - "$IPC_SOCKET"
    ;;
  "toggle-mute")
    echo 'cycle mute' | socat - "$IPC_SOCKET"
    ;;
  "cycle-fit")
    # Cycle between 0.0 (Fit with bars, no crop) and 1.0 (Fill/Crop, no bars)
    echo 'cycle-values panscan 0.0 1.0' | socat - "$IPC_SOCKET"
    ;;
  "cycle-aspect")
    # Cycle video aspect ratio override: Original -> 16:9 (Stretch to Wide) -> 4:3 (Stretch to Box)
    echo 'cycle-values video-aspect-override "-1" "16:9" "4:3"' | socat - "$IPC_SOCKET"
    ;;
  "seek-forward")
    echo 'seek 10' | socat - "$IPC_SOCKET"
    ;;
  "seek-backward")
    echo 'seek -10' | socat - "$IPC_SOCKET"
    ;;
  "download")
    URL=$(get_prop "path")
    TITLE=$(get_prop "media-title")
    TERMINAL="${TERMINAL:-kitty}"

    # Check if it's a local file
    LOCAL_FILE=$(is_local_video_file "$URL")
    if [ $? -eq 0 ]; then
        notify-send "Live Wallpaper" "This is already a local file: $LOCAL_FILE"
        exit 0
    fi

    if [ -n "$URL" ] && [ "$URL" != "null" ]; then
       notify-send "Live Wallpaper" "Downloading: $TITLE"

       if command -v "$TERMINAL" > /dev/null; then
            # Check for axel
            DL_ARGS=""
            if command -v axel > /dev/null; then
                DL_ARGS="--external-downloader axel --external-downloader-args '-n 10'"
            fi

            $TERMINAL --class floating-term --hold -e sh -c "yt-dlp $DL_ARGS -o '$HOME/Downloads/%(title)s.%(ext)s' '$URL'; echo \"\"; echo 'Download finished. Press Enter to close.'; read" &
       else
            notify-send "Error" "Terminal '$TERMINAL' not found for download."
       fi
    else
       notify-send "Error" "No video playing"
    fi
    ;;
  "open")
    URL=$(get_prop "path")
    
    # Check if it's a local file
    LOCAL_FILE=$(is_local_video_file "$URL")
    if [ $? -eq 0 ]; then
        notify-send "Live Wallpaper" "Opening file location..."
        xdg-open "$(dirname "$LOCAL_FILE")"
        exit 0
    fi
    
    if [ -n "$URL" ] && [ "$URL" != "null" ]; then
       notify-send "Live Wallpaper" "Opening in browser..."
       xdg-open "$URL"
    else
       notify-send "Error" "No video playing"
    fi
    ;;
  "cycle-quality")
    # Check if current video is a local file
    URL=$(get_prop "path")
    LOCAL_FILE=$(is_local_video_file "$URL")
    if [ $? -eq 0 ]; then
        notify-send "Live Wallpaper" "Quality cycling not available for local files"
        exit 0
    fi
    
    # Cycle order: 1080p -> 720p -> 480p -> best -> 1080p
    NEXT_QUALITY="1080p"
    case "$CURRENT_QUALITY" in
        "1080p") NEXT_QUALITY="720p" ;;
        "720p") NEXT_QUALITY="480p" ;;
        "480p") NEXT_QUALITY="best" ;;
        "best") NEXT_QUALITY="1080p" ;;
    esac

    # Save preference
    echo "$NEXT_QUALITY" > "$QUALITY_FILE"
    notify-send "Live Wallpaper" "Switching quality to $NEXT_QUALITY..."
    log_msg "Switching quality from $CURRENT_QUALITY to $NEXT_QUALITY"

    # Reload if playing
    if [ -S "$IPC_SOCKET" ]; then
        POS=$(get_prop "time-pos")

        if [ "$URL" != "null" ] && [ -n "$URL" ]; then
            # We can't change ytdl-format on the fly easily without reloading the file.
            # mpv supports 'set ytdl-format ...' but it only takes effect on next load.
            YTDL_FMT=$(get_fmt_string "$NEXT_QUALITY")

            # Send command to update property and reload
            # This sets ONLY the format string, which is correct (unlike before)
            echo "{ \"command\": [\"set_property\", \"ytdl-format\", \"$YTDL_FMT\"] }" | socat - "$IPC_SOCKET" > /dev/null

            # Seek to current position to force reload/re-buffer (or just reload file)
            # 'loadfile url replace start=POS' is cleanest
            if [ "$POS" == "null" ]; then POS=0; fi
            echo "loadfile \"$URL\" replace start=$POS" | socat - "$IPC_SOCKET"
        fi
    fi
    ;;
esac
